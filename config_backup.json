
{
    "source": {
        "type": "csv",
        "path": "data/input/raw_customers.csv"
    },

    "cleaning": {
        "missing_values": ["", "na", "n/a", "null", "none"],
        "defaults": {
            "country": "Namibia"
        }
    },

    "rename_columns": {
        "Customer ID": "id",
        "Full Name": "name"
    },

    "types": {
        "id": "int",
        "age": "int",
        "amount": "float",
        "active": "bool",
        "signup_date": "date"
    },

    "required_columns": [
        "id",
        "name"
    ],

    "deduplicate_by": [
        "id"
    ],

    "output": {
        "formats": ["csv", "json"],
        "csv": "data/output/cleaned_customers.csv",
        "json": "data/output/cleaned_customers.json",
        "summary": "data/output/summary.json"
    },

    "logging": {
        "level": "INFO",
        "file": "logs/pipeline.log"
    }
}
